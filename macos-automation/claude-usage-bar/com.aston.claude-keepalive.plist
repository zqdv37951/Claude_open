<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aston.claude-keepalive</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/aston/.local/bin/claude</string>
        <string>-p</string>
        <string>ping</string>
        <string>--output-format</string>
        <string>text</string>
    </array>
    <key>StartInterval</key>
    <integer>14400</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/aston/Library/Logs/claude-keepalive/claude-keepalive.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aston/Library/Logs/claude-keepalive/claude-keepalive.err</string>
</dict>
</plist>
